# =============================================================================
# Fouza Physiotherapy — Environment Variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local or secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Fouza Physiotherapy"
NEXT_PUBLIC_PRACTICE_NAME="Fouza Physiotherapy"
NEXT_PUBLIC_PRACTICE_EMAIL=info@fouzaphysio.com
NEXT_PUBLIC_PRACTICE_PHONE=+27000000000
NEXT_PUBLIC_PRACTICE_ADDRESS="47 Upper Duke Street, Walmer Estate, Cape Town, 7925"
NEXT_PUBLIC_PRACTICE_NUMBER=

# Interim external booking (Setmore) until Phase 6 native booking
NEXT_PUBLIC_BOOKING_EXTERNAL_URL=https://fouzaphysiotherapy.setmore.com/

# -----------------------------------------------------------------------------
# Supabase (Auth + Database + Storage)
# Dashboard → Project Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose to the client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Database (optional direct connection for migrations / tooling)
# Dashboard → Project Settings → Database
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.your-project.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# Resend (Transactional email)
# https://resend.com/api-keys
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL="Fouza Physiotherapy <noreply@fouzaphysiotherapy.co.za>"
RESEND_REPLY_TO=fouza.physiotherapy@gmail.com

# -----------------------------------------------------------------------------
# Google Reviews (Place Details / Business Profile)
# -----------------------------------------------------------------------------
# Place ID for Fouza Physiotherapy (47 Upper Duke St, Walmer Estate)
GOOGLE_PLACE_ID=ChIJyT3OtXNdzB0RVyqbwWpw4pM
# Optional — Places Details API refreshes the top 5 reviews + rating totals
GOOGLE_PLACES_API_KEY=
NEXT_PUBLIC_GOOGLE_REVIEW_URL=https://search.google.com/local/writereview?placeid=ChIJyT3OtXNdzB0RVyqbwWpw4pM

# -----------------------------------------------------------------------------
# Auth / Session
# -----------------------------------------------------------------------------
# Cookie & JWT settings are managed by Supabase Auth.
# Optional: site URL overrides for magic-link / OAuth redirects
NEXT_PUBLIC_AUTH_REDIRECT_URL=http://localhost:3000/auth/callback

CRON_SECRET=

# -----------------------------------------------------------------------------
# Website analytics (optional — Phase 2)
# Leave blank until GA4 and Search Console are ready. Analytics stays off
# until a G- measurement ID is set and the visitor accepts cookies.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# -----------------------------------------------------------------------------
# Feature flags (optional)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_ONLINE_BOOKING=true
NEXT_PUBLIC_ENABLE_PATIENT_PORTAL=true
NEXT_PUBLIC_ENABLE_BLOG=true
NEXT_PUBLIC_ENABLE_GOOGLE_REVIEWS=true

# -----------------------------------------------------------------------------
# Vercel (auto-injected in production — do not set locally)
# -----------------------------------------------------------------------------
# VERCEL_URL=
# VERCEL_ENV=
